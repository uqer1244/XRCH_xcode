// Copy to LocalSecrets.xcconfig and fill in your own project settings.
// Host only, without https:// or a trailing slash.
SUPABASE_PROJECT_HOST = your-project.supabase.co
// Public anon/publishable key only. NEVER use a service-role or secret key.
SUPABASE_ANON_KEY = YOUR_PUBLIC_SUPABASE_KEY
// Needed only for signing on a physical device.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
